<Window x:Class="TattleTail.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="TattleTail"
        Width="1280" Height="860"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ReadOnlyGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE5E5E5" />
            <Setter Property="AlternatingRowBackground" Value="#FFF7F9FC" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
        </Style>

        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Clear history…" Padding="10,3" Margin="6,0,0,0"
                    Click="OnClearHistoryClicked" ToolTip="Delete all saved traffic history" />
            <Button DockPanel.Dock="Right" Content="Reset counters" Padding="10,3" Margin="6,0,0,0"
                    Click="OnResetClicked" ToolTip="Set the live totals in the tables back to zero (history is kept)" />
            <CheckBox DockPanel.Dock="Right" Content="Show exited programs" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding ShowExitedPrograms}"
                      ToolTip="Keep programs that have closed all their connections in the Programs tab" />
            <CheckBox DockPanel.Dock="Right" Content="Reverse DNS" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding ReverseDnsLookups}"
                      ToolTip="For addresses whose name we didn't see looked up, ask DNS for the server's name.&#x0a;Turn off to avoid making any network requests of our own." />
            <ComboBox DockPanel.Dock="Right" Width="190" Margin="6,0,0,0"
                      ItemsSource="{Binding AddressDisplayOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding AddressDisplay}" />
            <TextBlock DockPanel.Dock="Right" Text="Show servers as:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock DockPanel.Dock="Left" Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="3"
                     ToolTip="Type part of a program name, PID, website, address, port or state" />
        </DockPanel>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Summary}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding TrafficStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="DarkGreen" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrafficAvailable}" Value="False">
                                    <Setter Property="Foreground" Value="DarkRed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding NamesStatus}" Foreground="DarkRed" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8,4,8,8">
            <TabItem Header="Programs">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="340" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ProgramsGrid" Grid.Row="0" Style="{StaticResource ReadOnlyGrid}"
                              SelectionMode="Single"
                              ItemsSource="{Binding ProgramsView}"
                              SelectedItem="{Binding HistoryPanel.SelectedProgram, Mode=TwoWay}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding ProcessPath}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                        <Setter Property="Foreground" Value="Gray" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Program" Binding="{Binding ProcessName}" Width="200" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"
                                                ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Connections" Binding="{Binding ConnectionCount}" Width="90"
                                                ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Upload" Binding="{Binding SendRateText}" SortMemberPath="SendRate"
                                                Width="100" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Download" Binding="{Binding ReceiveRateText}" SortMemberPath="ReceiveRate"
                                                Width="100" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Sent" Binding="{Binding SentText}" SortMemberPath="SentBytes"
                                                Width="100" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}" SortMemberPath="ReceivedBytes"
                                                Width="100" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Path" Binding="{Binding ProcessPath}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4"
                                  Background="#FFE0E0E0" ShowsPreview="False" />

                    <!-- History: chart and servers for the selected program (or all programs) -->
                    <DockPanel Grid.Row="2" DataContext="{Binding HistoryPanel}" Margin="0,4,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,4" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Style="{StaticResource PanelHeader}" />
                            <Button DockPanel.Dock="Left" Content="Show all programs" Margin="10,0,0,0" Padding="8,1"
                                    Click="OnShowAllProgramsClicked"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding TotalsText}" Margin="16,0,0,0"
                                       VerticalAlignment="Center" Foreground="#FF555555" />
                            <ComboBox DockPanel.Dock="Right" Width="150"
                                      ItemsSource="{Binding Ranges}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Range}" />
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="250" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="480" MinWidth="250" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <sp:WpfPlot x:Name="TrafficChart" MouseMove="OnChartMouseMove" MouseLeave="OnChartMouseLeave" />
                                <Border x:Name="ChartReadout" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,6,10,0" Padding="6,3" Background="#E6FFFFFF" BorderBrush="#FFCCCCCC"
                                        BorderThickness="1" CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock x:Name="ChartReadoutText" FontFamily="Consolas" />
                                </Border>
                            </Grid>

                            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="4"
                                          Background="#FFE0E0E0" ShowsPreview="False" />

                            <DataGrid Grid.Column="2" Style="{StaticResource ReadOnlyGrid}" ItemsSource="{Binding ServersView}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="ToolTip" Value="{Binding Details}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="*" />
                                    <DataGridTextColumn Header="Programs" Binding="{Binding Programs}" SortMemberPath="ProgramCount"
                                                        Width="90" />
                                    <DataGridTextColumn Header="Sent" Binding="{Binding SentText}" SortMemberPath="SentBytes"
                                                        Width="75" ElementStyle="{StaticResource NumberCell}" />
                                    <DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}" SortMemberPath="ReceivedBytes"
                                                        Width="75" ElementStyle="{StaticResource NumberCell}" />
                                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenText}" SortMemberPath="LastSeenLocal"
                                                        Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Connections">
                <DataGrid Style="{StaticResource ReadOnlyGrid}" ItemsSource="{Binding ConnectionsView}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding ProcessPath}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Program" Binding="{Binding ProcessName}" Width="160" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="50" />
                        <DataGridTextColumn Header="Local address" Binding="{Binding LocalAddress}" Width="190" />
                        <DataGridTextColumn Header="Remote server" Binding="{Binding RemoteText}" Width="*">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="ToolTip" Value="{Binding RemoteDetails}" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Port" Binding="{Binding RemotePortText}" SortMemberPath="RemotePort"
                                            Width="55" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                        <DataGridTextColumn Header="Upload" Binding="{Binding SendRateText}" SortMemberPath="SendRate"
                                            Width="85" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Download" Binding="{Binding ReceiveRateText}" SortMemberPath="ReceiveRate"
                                            Width="85" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Sent" Binding="{Binding SentText}" SortMemberPath="SentBytes"
                                            Width="80" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}" SortMemberPath="ReceivedBytes"
                                            Width="80" ElementStyle="{StaticResource NumberCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
