<Window x:Class="TattleTail.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TattleTail.App.ViewModels"
        Title="TattleTail"
        Width="1200" Height="720"
        MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ReadOnlyGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE5E5E5" />
            <Setter Property="AlternatingRowBackground" Value="#FFF7F9FC" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar: search box and buttons -->
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Reset counters" Padding="10,3" Margin="8,0,0,0"
                    Click="OnResetClicked" ToolTip="Set all traffic totals back to zero" />
            <CheckBox DockPanel.Dock="Right" Content="Show exited programs" VerticalAlignment="Center" Margin="8,0,0,0"
                      IsChecked="{Binding ShowExitedPrograms}"
                      ToolTip="Keep programs that have closed all their connections in the Programs tab" />
            <TextBlock DockPanel.Dock="Left" Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="3"
                     ToolTip="Type part of a program name, PID, address, port or state" />
        </DockPanel>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Summary}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding TrafficStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="DarkGreen" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrafficAvailable}" Value="False">
                                    <Setter Property="Foreground" Value="DarkRed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8,4,8,8">
            <TabItem Header="Programs">
                <DataGrid Style="{StaticResource ReadOnlyGrid}" ItemsSource="{Binding ProgramsView}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding ProcessPath}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Program" Binding="{Binding ProcessName}" Width="200" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Connections" Binding="{Binding ConnectionCount}" Width="90"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Upload" Binding="{Binding SendRateText}" SortMemberPath="SendRate"
                                            Width="100" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Download" Binding="{Binding ReceiveRateText}" SortMemberPath="ReceiveRate"
                                            Width="100" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Sent" Binding="{Binding SentText}" SortMemberPath="SentBytes"
                                            Width="100" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}" SortMemberPath="ReceivedBytes"
                                            Width="100" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Path" Binding="{Binding ProcessPath}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Connections">
                <DataGrid Style="{StaticResource ReadOnlyGrid}" ItemsSource="{Binding ConnectionsView}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding ProcessPath}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Program" Binding="{Binding ProcessName}" Width="170" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="55" />
                        <DataGridTextColumn Header="Local address" Binding="{Binding LocalAddress}" Width="*" />
                        <DataGridTextColumn Header="Remote address" Binding="{Binding RemoteAddress}" Width="*" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="95" />
                        <DataGridTextColumn Header="Upload" Binding="{Binding SendRateText}" SortMemberPath="SendRate"
                                            Width="90" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Download" Binding="{Binding ReceiveRateText}" SortMemberPath="ReceiveRate"
                                            Width="90" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Sent" Binding="{Binding SentText}" SortMemberPath="SentBytes"
                                            Width="85" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}" SortMemberPath="ReceivedBytes"
                                            Width="85" ElementStyle="{StaticResource NumberCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
