<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TattleTail</AssemblyName>
    <RootNamespace>TattleTail.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.0</Version>
    <Product>TattleTail</Product>
    <Description>See which programs are talking to the network, and how much.</Description>
    <!-- Lets the project build on non-Windows machines (e.g. CI or Linux dev boxes). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- SkiaSharp.Views.WPF (used by the ScottPlot chart) only ships a .NET Framework build,
         which runs fine on .NET 8; NU1701 just notes that. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TattleTail.Core\TattleTail.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.57" />
  </ItemGroup>

</Project>
