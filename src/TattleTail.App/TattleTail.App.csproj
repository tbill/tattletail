<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the system-tray icon (NotifyIcon), which WPF doesn't have. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TattleTail</AssemblyName>
    <RootNamespace>TattleTail.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Releases get their version from the tag (see .github/workflows/release.yml).
         Everything else is a "dev" build, labelled with its git commit. -->
    <Version>0.0.0.0</Version>
    <InformationalVersion>dev</InformationalVersion>
    <Product>TattleTail</Product>
    <Description>See which programs are talking to the network, and how much.</Description>
    <!-- Lets the project build on non-Windows machines (e.g. CI or Linux dev boxes). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- SkiaSharp.Views.WPF (used by the ScottPlot chart) only ships a .NET Framework build,
         which runs fine on .NET 8; NU1701 just notes that. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms brings its own Application, MessageBox, Color... which would clash with
         WPF's. The one file that needs them (TrayIcon.cs) asks for them by name. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TattleTail.Core\TattleTail.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.57" />
  </ItemGroup>

</Project>
