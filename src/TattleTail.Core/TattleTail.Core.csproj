<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.33" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mozilla Public Suffix List (MPL-2.0), used to group hosts by domain. -->
    <EmbeddedResource Include="Names\Data\public_suffix_list.dat" LogicalName="TattleTail.Core.public_suffix_list.dat" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TattleTail.Core.Tests" />
  </ItemGroup>

</Project>
